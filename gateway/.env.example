# Puerto público del Gateway (el frontend debe apuntar aquí)
GATEWAY_PORT=8080
# DEBE ser el mismo JWT_SECRET que usa el backend de FoodTrace (backend/.env)
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_LA_MISMA_DEL_BACKEND_DE_FOODTRACE
# Servicios internos. Con el backend actual de FoodTrace los tres apuntan a la misma API.
AUTH_URL=http://127.0.0.1:5000
TRACE_URL=http://127.0.0.1:5000
QR_URL=http://127.0.0.1:5000
# Origen del frontend permitido por CORS
CLIENT_URL=http://localhost:5173
CACHE_TTL_MS=30000
RATE_LIMIT=1000
UPSTREAM_TIMEOUT_MS=5000
AUDIT_FILE=audit.log
